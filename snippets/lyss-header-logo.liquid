<a
  href="{{ routes.root_url }}"
  class="header-logo lyss-header-logo"
  aria-label="{{ 'accessibility.home_logo_alt' | t: store_name: shop.name | escape }}"
>
  <img
    src="{{ 'lyss-image-14.webp' | asset_url }}"
    class="lyss-header-logo__image"
    width="136"
    height="78"
    alt="{{ shop.name | escape }}"
  >
</a>
