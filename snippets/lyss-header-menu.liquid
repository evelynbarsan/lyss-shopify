{% if variant == 'mobile' %}
  <div
    class="menu-list menu-list--mobile lyss-mobile-menu"
    data-navigation-bar-enabled
  >
    <div class="menu-list__scroll-container">
      <ul class="menu-list__list list-unstyled" role="list">
        <li class="menu-list__list-item">
          <a
            href="{{ routes.root_url }}"
            class="menu-list__item lyss-mobile-menu__link"
            {% if request.page_type == 'index' %}
              aria-current="page"
            {% endif %}
          >
            Início
          </a>
        </li>
        <li class="menu-list__list-item">
          <a
            href="{{ routes.all_products_collection_url }}"
            class="menu-list__item lyss-mobile-menu__link"
            {% if request.page_type == 'collection' and collection.handle == 'all' %}
              aria-current="page"
            {% endif %}
          >
            Catálogo
          </a>
        </li>
      </ul>
    </div>
  </div>
{% else %}
  <nav class="lyss-header-menu" aria-label="Navegação principal">
    <a
      href="{{ routes.root_url }}"
      {% if request.page_type == 'index' %}
        aria-current="page"
      {% endif %}
    >
      Início
    </a>
    <a
      href="{{ routes.all_products_collection_url }}"
      {% if request.page_type == 'collection' and collection.handle == 'all' %}
        aria-current="page"
      {% endif %}
    >
      Catálogo
    </a>
  </nav>
{% endif %}
