{% doc %}
  @prompt
    preciso de um catalogo de venda
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-catalog-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin-inline: auto;
    color: #222222;
  }

  .ai-catalog-{{ ai_gen_id }}__heading {
    margin: 0 0 24px;
    color: #222222;
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.2;
  }

  .ai-catalog-{{ ai_gen_id }}__grid {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, minmax(0, 1fr));
    gap: {{ block.settings.gap }}px;
  }

  .ai-catalog-{{ ai_gen_id }}__card {
    min-width: 0;
    overflow: hidden;
    background: {{ block.settings.card_background }};
    border: 1px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.corner_radius }}px;
  }

  .ai-catalog-{{ ai_gen_id }}__image-link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .ai-catalog-{{ ai_gen_id }}__image-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: #f3f3f3;
  }

  .ai-catalog-{{ ai_gen_id }}__image-wrap img,
  .ai-catalog-{{ ai_gen_id }}__image-wrap svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-catalog-{{ ai_gen_id }}__details {
    padding: 16px;
  }

  .ai-catalog-{{ ai_gen_id }}__title {
    margin: 0 0 8px;
    color: #222222;
    font-size: 16px;
    line-height: 1.4;
  }

  .ai-catalog-{{ ai_gen_id }}__title a {
    color: inherit;
    text-decoration: none;
  }

  .ai-catalog-{{ ai_gen_id }}__title a:hover,
  .ai-catalog-{{ ai_gen_id }}__title a:focus-visible {
    text-decoration: underline;
  }

  .ai-catalog-{{ ai_gen_id }}__price {
    margin: 0 0 14px;
    color: #222222;
    font-size: 15px;
    font-weight: 600;
  }

  .ai-catalog-{{ ai_gen_id }}__button {
    display: flex;
    width: 100%;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    padding: 10px 14px;
    border: 1px solid {{ block.settings.button_background }};
    border-radius: {{ block.settings.button_radius }}px;
    background: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    font-size: 14px;
    font-weight: 600;
    text-align: center;
    text-decoration: none;
  }

  .ai-catalog-{{ ai_gen_id }}__button:hover {
    filter: brightness(0.9);
  }

  .ai-catalog-{{ ai_gen_id }}__button:focus-visible,
  .ai-catalog-{{ ai_gen_id }}__title a:focus-visible,
  .ai-catalog-{{ ai_gen_id }}__image-link:focus-visible {
    outline: 2px solid #222222;
    outline-offset: 3px;
  }

  .ai-catalog-{{ ai_gen_id }}__empty {
    padding: 24px;
    border: 1px dashed #777777;
    color: #555555;
    text-align: center;
  }

  @media screen and (max-width: 749px) {
    .ai-catalog-{{ ai_gen_id }}__grid {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, minmax(0, 1fr));
      gap: 12px;
    }

    .ai-catalog-{{ ai_gen_id }}__details {
      padding: 12px;
    }

    .ai-catalog-{{ ai_gen_id }}__title {
      font-size: 14px;
    }

    .ai-catalog-{{ ai_gen_id }}__button {
      padding-inline: 8px;
      font-size: 13px;
    }
  }
{% endstyle %}

<div class="ai-catalog-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}
    <h2 class="ai-catalog-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>
  {% endif %}

  {% if block.settings.products != blank %}
    <div class="ai-catalog-{{ ai_gen_id }}__grid">
      {% for product in block.settings.products %}
        <article class="ai-catalog-{{ ai_gen_id }}__card">
          <a class="ai-catalog-{{ ai_gen_id }}__image-link" href="{{ product.url }}" aria-label="Ver {{ product.title | escape }}">
            <div class="ai-catalog-{{ ai_gen_id }}__image-wrap">
              {% if product.featured_image %}
                <img
                  src="{{ product.featured_image | image_url: width: 800 }}"
                  alt="{{ product.featured_image.alt | default: product.title | escape }}"
                  loading="lazy"
                  width="{{ product.featured_image.width }}"
                  height="{{ product.featured_image.height }}"
                >
              {% else %}
                {{ 'product-apparel-1' | placeholder_svg_tag }}
              {% endif %}
            </div>
          </a>
          <div class="ai-catalog-{{ ai_gen_id }}__details">
            <h3 class="ai-catalog-{{ ai_gen_id }}__title"><a href="{{ product.url }}">{{ product.title | escape }}</a></h3>
            {% if block.settings.show_price %}
              <p class="ai-catalog-{{ ai_gen_id }}__price">{{ product.price | money }}</p>
            {% endif %}
            <a class="ai-catalog-{{ ai_gen_id }}__button" href="{{ product.url }}">{{ block.settings.button_label | escape }}</a>
          </div>
        </article>
      {% endfor %}
    </div>
  {% else %}
    <div class="ai-catalog-{{ ai_gen_id }}__empty">Adicione produtos nas configurações deste bloco para montar seu catálogo.</div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Catálogo de venda",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Conheça nossos produtos"
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "Produtos",
      "limit": 12
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Exibir preço",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto do botão",
      "default": "Ver produto"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Largura no desktop",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Colunas no desktop",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "3"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Colunas no celular",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Espaço entre produtos",
      "min": 8,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Tamanho do título",
      "min": 20,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 30
    },
    {
      "type": "header",
      "content": "Aparência"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Fundo do cartão",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Borda do cartão",
      "default": "#E5E5E5"
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Arredondamento do cartão",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Fundo do botão",
      "default": "#222222"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Texto do botão",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "button_radius",
      "label": "Arredondamento do botão",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "Catálogo de venda"
    }
  ],
  "tag": null,
  "class": "catalogo-venda"
}
{% endschema %}